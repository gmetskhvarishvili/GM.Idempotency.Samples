<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
      This sample references the sibling source repo by project path so it builds against the
      current code. Once the packages are published, swap these for:
        <PackageReference Include="GM.Idempotency"          Version="1.0.0" />
        <PackageReference Include="GM.Idempotency.Http"     Version="1.0.0" />
        <PackageReference Include="GM.Idempotency.Mediator" Version="1.0.0" />
        <PackageReference Include="GM.Caching"              Version="1.0.0" />
        <PackageReference Include="GM.DistributedLock"      Version="1.0.0" />
        <PackageReference Include="GM.Mediator"             Version="1.3.2" />
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\GM.Idempotency\GM.Idempotency\GM.Idempotency.csproj" />
        <ProjectReference Include="..\..\GM.Idempotency\GM.Idempotency.Http\GM.Idempotency.Http.csproj" />
        <ProjectReference Include="..\..\GM.Idempotency\GM.Idempotency.Mediator\GM.Idempotency.Mediator.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GM.Caching" Version="1.0.0" />
        <PackageReference Include="GM.Caching.Redis" Version="1.0.0" />
        <PackageReference Include="GM.DistributedLock" Version="1.0.0" />
        <PackageReference Include="GM.DistributedLock.Redis" Version="1.0.0" />
        <PackageReference Include="GM.Mediator" Version="1.3.2" />
    </ItemGroup>

</Project>
